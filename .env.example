# HumPage Listen needs no database. Resend (resend.com) sends every email the site needs.

# Your live site address (used for sitemap and canonical links)
SITE_URL=https://humpagelisten.com

# Resend API key: powers the contact form and the newsletter
RESEND_API_KEY=
# Sender for all emails. Use an address on a domain you verified in Resend.
# onboarding@resend.dev only delivers to your own Resend account email (fine for testing the contact form).
EMAIL_FROM=HumPage Listen <hello@humpagelisten.com>
# Where contact form messages are delivered
CONTACT_TO_EMAIL=
# Optional: Resend segment that confirmed newsletter subscribers join
RESEND_SEGMENT_ID=
# Optional: secret for signing newsletter confirm links (defaults to the API key)
NEWSLETTER_SECRET=
